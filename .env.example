# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lari-industries?retryWrites=true&w=majority

# Razorpay (Payment Gateway)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Client-side Razorpay key (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Resend (Transactional Emails)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sender domain/email in Resend (e.g., orders@yourdomain.com)
RESEND_FROM_EMAIL=Lari Industries <orders@lariindustries.com>

# Optional: Custom domain for emails (if using Resend domains)
# RESEND_DOMAIN=lariindustries.com