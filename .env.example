# ==============================================================================
# LARI INDUSTRIES E-COMMERCE ENVIRONMENT VARIABLES
# ==============================================================================
# Add your Razorpay API Credentials below or in Vercel Project Settings > Environment Variables.

# Razorpay Key ID (Public key used by client checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YourKeyIdHere

# Razorpay Key Secret (Server-side secret used to create orders & verify signatures)
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Razorpay Webhook Secret (Used to cryptographically verify webhook payloads)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Production App URL (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
